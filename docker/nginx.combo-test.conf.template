map $http_upgrade $combo_test_connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name COMBO_TEST_HOST;
    location /.well-known/acme-challenge/ {
        root /var/www/combo-workspace-test-acme;
        try_files $uri =404;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name COMBO_TEST_HOST;
    ssl_certificate /etc/letsencrypt/live/combo-workspace-test/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/combo-workspace-test/privkey.pem;

    client_max_body_size 100m;
    location / {
        proxy_pass http://127.0.0.1:COMBO_API_PORT;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $combo_test_connection_upgrade;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
