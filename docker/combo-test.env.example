NODE_ENV=production
PORT=3005
SERVER_ROLE=all
HAPPIER_SERVER_HOST=0.0.0.0
HAPPIER_SERVER_TRUST_PROXY=1
PUBLIC_URL=https://combo-test.example.com
HAPPIER_PUBLIC_SERVER_URL=https://combo-test.example.com
HAPPIER_WEBAPP_URL=https://combo-test.example.com
HAPPIER_SERVER_FLAVOR=light
HAPPIER_DB_PROVIDER=sqlite
HAPPIER_SERVER_LIGHT_DATA_DIR=/data
HAPPIER_FEATURE_SHARING_SESSION_ENTRIES__ENABLED=1
HAPPIER_FEATURE_ENCRYPTION__STORAGE_POLICY=required_e2ee
HAPPIER_FEATURE_E2EE__KEYLESS_ACCOUNTS_ENABLED=0
HAPPIER_FEATURE_AUTH_OAUTH__KEYLESS_ENABLED=0
METRICS_ENABLED=false
AUTH_PROVIDERS_CONFIG_PATH=/run/combo/oidc.json
AUTH_ANONYMOUS_SIGNUP_ENABLED=false
AUTH_SIGNUP_PROVIDERS=google
AUTH_REQUIRED_LOGIN_PROVIDERS=google
